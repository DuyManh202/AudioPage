# ====================================================================
# CẤU HÌNH KẾT NỐI AIVEN POSTGRESQL (TÚ AUDIO)
# ====================================================================
# Lấy chuỗi này tại: Aiven Console -> Service pg-21e23fcb -> Overview -> Service URI
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Cổng khởi chạy máy chủ backend
PORT=5000
CORS_ORIGINS=http://localhost:5173

# Khóa bí mật mã hóa phiên đăng nhập JWT của Admin
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Chỉ dùng một lần với `npm run admin:create` để tạo quản trị viên đầu tiên
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
BOOTSTRAP_ADMIN_FULL_NAME=Store Administrator
BOOTSTRAP_ADMIN_PHONE=0900000000

# Meta Messenger Platform (chỉ đặt trên backend, không đưa vào VITE_*)
META_PAGE_ID=your_facebook_page_id
META_PAGE_ACCESS_TOKEN=your_page_access_token
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=generate_a_long_random_string
# Lấy Graph API version còn được Meta hỗ trợ trong dashboard/tài liệu tại thời điểm cấu hình
META_GRAPH_VERSION=vXX.Y

# Meta Ads (đọc quảng cáo đang chạy và hiệu quả 30 ngày; quyền ads_read)
META_AD_ACCOUNT_ID=act_your_ad_account_id
META_ADS_ACCESS_TOKEN=your_ads_read_access_token

# AI tư vấn Messenger (nhập API key chỉ trên Render Environment)
META_AI_ENABLED=false
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=your_enabled_model_id
